# Paths to your OAuth client and cached token (see README setup steps)
GMAIL_MCP_CREDENTIALS=secrets/credentials.json
GMAIL_MCP_TOKEN=secrets/token.json

# Comma-separated hostnames this server is allowed to be reached as, for
# DNS-rebinding protection. Only needed for HTTP deployments.
GMAIL_MCP_ALLOWED_HOSTS=mcp.example.com

# Set to 1 to enable the OAuth 2.1 authorization server (required for HTTP
# clients like ChatGPT that only support None/OAuth, not a bearer header).
# Leave unset for local stdio use with Claude Code, no OAuth needed there.
GMAIL_MCP_ENABLE_OAUTH=1
GMAIL_MCP_ISSUER_URL=https://mcp.example.com

# A stable identifier for your client. Not secret, just needs to match what
# you paste into your MCP client's "OAuth Client ID" field.
GMAIL_MCP_OAUTH_CLIENT_ID=change-me

# Where your MCP client redirects after authorizing (its own callback URL).
GMAIL_MCP_OAUTH_REDIRECT_URIS=https://your-client.example.com/oauth/callback

# The passphrase you'll type into the consent screen to approve access.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
GMAIL_MCP_OAUTH_PASSPHRASE=change-me

# Where OAuth codes/tokens are persisted (relative to the working directory,
# or an absolute path inside the container in Docker deployments).
GMAIL_MCP_OAUTH_STATE=secrets/oauth_state.json
